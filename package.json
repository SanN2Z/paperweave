{
  "name": "paperweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local research workbench connecting papers, knowledge maps, CLI agents and Obsidian through MCP.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pty.js",
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node scripts/launch.js",
    "serve": "node server/index.js",
    "mcp": "node server/mcp.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "node scripts/browser-check.js",
    "desktop:stage": "node scripts/desktop-stage.js",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "dompurify": "^3.2.7",
    "express": "^5.1.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.1",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.11.4",
    "prettier": "^3.9.6",
    "vite": "^7.3.1"
  }
}
